<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Events</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
    <header class="site-header">
        <h1>Campus Events</h1>
        <p>Discover, create and manage campus events.</p>
    </header>

    <main class="container">
        <section class="panel">
            <h2>Create Event</h2>

            <form id="event-form">
                <label for="event-title">Event Title</label>
                <input
                    type="text"
                    id="event-title"
                    placeholder="Enter event title"
                    maxlength="100"
                    required
                >

                <label for="event-date">Event Date</label>
                <input type="date" id="event-date" required>

                <label for="event-venue">Venue</label>
                <input
                    type="text"
                    id="event-venue"
                    placeholder="Enter venue"
                    maxlength="100"
                    required
                >

                <label for="event-desc">Description</label>
                <textarea
                    id="event-desc"
                    placeholder="Describe your event"
                    rows="3"
                    maxlength="500"
                    required
                ></textarea>

                <button type="submit">Add Event</button>
            </form>

            <p id="form-message" role="status" aria-live="polite"></p>
        </section>

        <section class="panel">
            <div class="events-heading">
                <h2>Upcoming Events</h2>
                <span id="event-count">0 events</span>
            </div>

            <label for="search-input">Search Events</label>
            <input
                type="search"
                id="search-input"
                placeholder="Search by title, venue or description..."
            >

            <div id="events-container" class="events-grid">
                <!-- Event cards are added using JavaScript -->
            </div>
        </section>
    </main>

    <footer>
        <p>Campus Events Manager | Student Project</p>
    </footer>
</body>
</html>
